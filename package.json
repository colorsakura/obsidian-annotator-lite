{
  "name": "obsidian-annotator-lite",
  "version": "1.0.0",
  "description": "An Obsidian plugin to annotate EPUB files.",
  "main": "main.js",
  "scripts": {
    "dev": "vite build --watch --mode development",
    "build": "tsc -noEmit -skipLibCheck && vite build --mode production",
    "version": "node version-bump.js",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "check": "biome check ."
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "2.4.15",
    "@blacksmithgu/datacore": "^0.1.24",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "builtin-modules": "5.2.0",
    "esbuild": "^0.28.0",
    "obsidian": "latest",
    "tslib": "2.8.1",
    "typescript": "6.0.3",
    "vite": "^8.0.14"
  },
  "dependencies": {
    "foliate-js": "^1.0.1",
    "pdfjs-dist": "^5.7.284",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  }
}
