{
  "name": "obsidian-annotator-lite",
  "version": "1.0.0",
  "description": "An Obsidian plugin to annotate EPUB files.",
  "main": "main.js",
  "scripts": {
    "dev": "bun run build.ts --watch",
    "build": "tsc -noEmit -skipLibCheck && bun run build.ts --production",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "eslint . && tsc -noEmit -skipLibCheck",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@blacksmithgu/datacore": "^0.1.24",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^4.1.10",
    "builtin-modules": "5.3.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-obsidianmd": "^0.4.1",
    "eslint-plugin-react": "^7.37.5",
    "jsdom": "^29.1.1",
    "obsidian": "latest",
    "prettier": "^3.9.5",
    "tslib": "2.8.1",
    "typescript": "7.0.2",
    "typescript-eslint": "^8.64.0",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.101.2",
    "foliate-js": "johnfactotum/foliate-js",
    "lucide-react": "^1.24.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  }
}
