{
  "name": "obsidian-annotator-lite",
  "version": "1.0.0",
  "description": "An Obsidian plugin to annotate EPUB files.",
  "main": "main.js",
  "scripts": {
    "dev": "bun run build.ts --watch",
    "build": "tsc -noEmit -skipLibCheck && bun run build.ts --production",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "eslint . && tsc -noEmit -skipLibCheck",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@blacksmithgu/datacore": "^0.1.24",
    "@eslint/js": "^9.39.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.9.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitest/browser": "^4.1.8",
    "builtin-modules": "5.2.0",
    "esbuild": "^0.28.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-obsidianmd": "^0.3.0",
    "eslint-plugin-react": "^7.37.5",
    "jsdom": "^29.1.1",
    "obsidian": "latest",
    "prettier": "^3.8.4",
    "tslib": "2.8.1",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.60.1",
    "vitest": "^4.1.8"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.85.6",
    "foliate-js": "johnfactotum/foliate-js",
    "lucide-react": "^1.17.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  }
}
